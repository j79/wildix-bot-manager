# ── Ports (override si conflits sur ton hôte) ─────────────────────────────
FRONTEND_PORT=80
BACKEND_PORT=3000
PB_PORT=8090
OLLAMA_PORT=11434

# ── Backend ────────────────────────────────────────────────────────────────
PORT=3000
POCKETBASE_URL=http://pocketbase:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme

# ── LLM ───────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama          # ollama | openai | groq
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OPENAI_API_KEY=
GROQ_API_KEY=

# ── TTS ───────────────────────────────────────────────────────────────────
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=

# ── Frontend (injecté au build Vite) ──────────────────────────────────────
# En docker-compose : /api (proxifié par nginx vers le backend)
# En dev local      : http://localhost:3000
VITE_API_URL=/api
